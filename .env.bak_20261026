# =============================================================================
# Настройки для отправки писем клиентам (SMTP)
# Заполните значения ниже. Файл .env не попадает в git.
# Можно оставить пустым и заполнить в CRM: Настройки → Общие → Почта (SMTP).
# При сохранении почты в CRM эти ключи обновляются здесь (если .env найден).
# =============================================================================

# Адрес SMTP-сервера (например: smtp.gmail.com, smtp.yandex.ru, smtp.mail.ru)
MAIL_SERVER=

# Порт: обычно 587 (TLS) или 465 (SSL)
MAIL_PORT=587

# Использовать TLS (для порта 587 — True)
MAIL_USE_TLS=True

# Использовать SSL (для порта 465 — True, тогда MAIL_USE_TLS=False)
MAIL_USE_SSL=False

# Логин SMTP — полный email ящика (ваш@email.ru)
MAIL_USERNAME=

# Пароль: для Gmail/Яндекс/Mail.ru — «пароль приложения», не обычный пароль от почты
MAIL_PASSWORD=

# От кого. В .env — mailbox; в CRM: Название вашей компании <ваш@email.ru>
# (email внутри <> = тот же, что логин MAIL_USERNAME).
MAIL_DEFAULT_SENDER=

# Таймаут соединения с SMTP в секундах (на Windows / слабом канале лучше 15, не 3)
MAIL_TIMEOUT=15
